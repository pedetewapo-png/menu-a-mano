{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "menu-a-mano",
  "compatibility_date": "2026-10-06",
  // Sitio estático: se publica tal cual la carpeta que genera `npm run build`.
  "assets": {
    "directory": "./dist",
    // Una ruta inexistente debe dar 404; si devolviera la página de instalación,
    // el service worker podría guardar HTML en lugar de un archivo que falta.
    "not_found_handling": "404-page"
  }
}
